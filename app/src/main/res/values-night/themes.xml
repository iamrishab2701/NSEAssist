<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Dark theme — window background matches the dark gradient start colour so
        there is no colour flash before Compose draws its first frame.
    -->
    <style name="Theme.NSEAssist" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#FF080C14</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>
</resources>
